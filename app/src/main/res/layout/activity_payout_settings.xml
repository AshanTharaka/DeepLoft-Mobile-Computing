<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payout Settings"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Income from your courses will be sent to the following account."
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/et_bank_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Bank Name (e.g. Chase, HSBC)"
        android:inputType="text" />

    <EditText
        android:id="@+id/et_bank_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Account Number"
        android:inputType="number"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btn_save_bank_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Payout Details"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Note: For security, use a dedicated business account."
        android:textSize="12sp"
        android:layout_marginTop="16dp"
        android:textColor="@android:color/holo_red_dark" />

</LinearLayout>