<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_plan_course"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Study Plan"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_plan_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Goal: 2 weeks"
        android:textColor="@android:color/darker_gray"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personalized AI Tasks"
        android:textStyle="bold"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tv_plan_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:text="Loading tasks..."
        android:lineSpacingExtra="8dp" />

    <Button
        android:id="@+id/btn_plan_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Learning"
        android:layout_marginTop="16dp" />

</LinearLayout>