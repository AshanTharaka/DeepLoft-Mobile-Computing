<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FF">

    <!-- Subtle Background Decoration -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/bg_chat_pleasant"
        android:alpha="0.3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-100dp"
        android:layout_marginEnd="-100dp" />

    <!-- Center Content -->
    <LinearLayout
        android:id="@+id/brand_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/action_layout"
        app:layout_constraintVertical_chainStyle="packed">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="140dp"
            android:layout_height="140dp"
            app:cardCornerRadius="70dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_deeploft_logo"
                android:padding="0dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/app_logo_desc" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deep"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="#1A237E" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loft"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="#00BFA5" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your AI-Powered Academic Journey"
            android:textSize="16sp"
            android:textColor="#757575"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:id="@+id/action_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_join_student"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Join as a Student"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="18sp"
            app:cornerRadius="16dp"
            app:backgroundTint="#1A237E"
            app:elevation="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_join_instructor"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Join as an Instructor"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="16dp"
            app:cornerRadius="16dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#1A237E"
            android:textColor="#1A237E"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/tv_already_have_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Already have an account? Login"
            android:textColor="#1A237E"
            android:textSize="15sp"
            android:layout_marginTop="32dp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>